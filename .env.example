# Required at runtime (set in Vercel → Project → Settings → Environment Variables)
DASHBOARD_PASSWORD=change-me
AUTH_SECRET=run "openssl rand -hex 32" and paste the result here

# Optional — without this the deployed app does not persist snapshots
# (each /api/refresh would overwrite). Get the token from
# Vercel → Storage → Create Blob Store → .env.local
BLOB_READ_WRITE_TOKEN=
